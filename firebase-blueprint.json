{
  "entities": {
    "User": {
      "title": "User",
      "description": "Global student/user identity in the multi-team robotics platform",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "team": { "type": "string" },
        "role": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" },
        "photoUrl": { "type": "string" },
        "isSuperAdmin": { "type": "boolean" },
        "isPlatformAdmin": { "type": "boolean" },
        "activeTeamId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "email", "photoUrl", "createdAt", "updatedAt"]
    },
    "Team": {
      "title": "Team",
      "description": "Independent robotics/engineering/competition team on the platform",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "shortCode": { "type": "string" },
        "competition": { "type": "string" },
        "schoolName": { "type": "string" },
        "city": { "type": "string" },
        "description": { "type": "string" },
        "motto": { "type": "string" },
        "logoKey": { "type": "string" },
        "logoUrl": { "type": "string" },
        "accentColorHex": { "type": "string" },
        "managerName": { "type": "string" },
        "managerContact": { "type": "string" },
        "founderId": { "type": "string" },
        "founderEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "suspended", "under_review", "rejected"] },
        "isMainTeam": { "type": "boolean" },
        "memberCount": { "type": "integer" },
        "rejectionReason": { "type": "string" },
        "reviewedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "shortCode", "competition", "schoolName", "city", "description", "managerName", "managerContact", "founderId", "founderEmail", "status", "isMainTeam", "createdAt", "updatedAt"]
    },
    "TeamMembership": {
      "title": "TeamMembership",
      "description": "Per-team membership and isolated roles/permissions for a user (doc ID: teamId_userId)",
      "type": "object",
      "properties": {
        "teamId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userPhotoUrl": { "type": "string" },
        "subTeam": { "type": "string" },
        "role": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["pending", "active", "approved", "rejected", "revoked"] },
        "isTeamAdmin": { "type": "boolean" },
        "joinNote": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "userId", "userName", "userEmail", "subTeam", "role", "roles", "status", "isTeamAdmin", "createdAt", "updatedAt"]
    },
    "TeamTask": {
      "title": "TeamTask",
      "description": "Team-scoped task / görev item inside a team's isolated workspace",
      "type": "object",
      "properties": {
        "teamId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "subTeam": { "type": "string" },
        "assignedToId": { "type": "string" },
        "assignedToName": { "type": "string" },
        "createdById": { "type": "string" },
        "createdByName": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string", "enum": ["todo", "in_progress", "done"] },
        "dueDateText": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "title", "subTeam", "createdById", "createdByName", "status", "createdAt", "updatedAt"]
    },
    "Room": {
      "title": "Room",
      "description": "Team chat room",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "teamId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "allowedTeam": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "name", "description", "allowedTeam", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message in a room",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "teamId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderPhotoUrl": { "type": "string" },
        "senderTeam": { "type": "string" },
        "text": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "replyToId": { "type": "string" },
        "replyToSender": { "type": "string" },
        "replyToText": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "senderId", "senderName", "senderTeam", "text", "isPinned", "createdAt", "updatedAt"]
    },
    "Idea": {
      "title": "Idea",
      "description": "Brainstorming or project idea",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "teamId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorTeam": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "likes": { "type": "array", "items": { "type": "string" } },
        "likeCount": { "type": "integer" },
        "fileUrl": { "type": "string" },
        "fileName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "authorId", "authorName", "authorTeam", "title", "description", "category", "likes", "likeCount", "createdAt", "updatedAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comment on an idea",
      "type": "object",
      "properties": {
        "ideaId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ideaId", "authorId", "authorName", "text", "createdAt"]
    },
    "SharedFile": {
      "title": "SharedFile",
      "description": "Workspace file (code, docs, designs, pdf)",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "teamId": { "type": "string" },
        "uploadedById": { "type": "string" },
        "uploadedByName": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "description": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "uploadedById", "uploadedByName", "fileName", "fileType", "description", "createdAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Team announcement broadcasted by leaders/admins",
      "type": "object",
      "properties": {
        "teamId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorName", "title", "content", "isPinned", "createdAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Member help & support ticket routed to team managers",
      "type": "object",
      "properties": {
        "teamId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userTeam": { "type": "string" },
        "category": { "type": "string" },
        "subject": { "type": "string" },
        "description": { "type": "string" },
        "appVersion": { "type": "string" },
        "deviceInfo": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved"] },
        "adminReply": { "type": "string" },
        "repliedByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "userEmail", "userTeam", "category", "subject", "description", "appVersion", "deviceInfo", "status", "adminReply", "repliedByName", "createdAt", "updatedAt"]
    },
    "TeamReopenWatch": {
      "title": "TeamReopenWatch",
      "description": "Subscription by a user to be notified when a suspended or under-review team reopens (doc ID: teamId_userId)",
      "type": "object",
      "properties": {
        "teamId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "userId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection"
    },
    "/teams/{teamId}": {
      "schema": "Team",
      "description": "Teams registry and team creation applications"
    },
    "/team_memberships/{membershipId}": {
      "schema": "TeamMembership",
      "description": "Isolated per-team membership and role assignments"
    },
    "/teams/{teamId}/tasks/{taskId}": {
      "schema": "TeamTask",
      "description": "Isolated tasks for a team"
    },
    "/teams/{teamId}/rooms/{roomId}": {
      "schema": "Room",
      "description": "Isolated rooms for a team"
    },
    "/teams/{teamId}/rooms/{roomId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Isolated messages inside a team room"
    },
    "/teams/{teamId}/ideas/{ideaId}": {
      "schema": "Idea",
      "description": "Isolated ideas for a team"
    },
    "/teams/{teamId}/ideas/{ideaId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Comments on isolated team ideas"
    },
    "/teams/{teamId}/files/{fileId}": {
      "schema": "SharedFile",
      "description": "Isolated shared files for a team"
    },
    "/teams/{teamId}/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Isolated announcements for a team"
    },
    "/teams/{teamId}/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Isolated support tickets for a team"
    },
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Main platform team (blacksea_robotics) rooms collection"
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Main platform team (blacksea_robotics) room messages subcollection"
    },
    "/ideas/{ideaId}": {
      "schema": "Idea",
      "description": "Main platform team (blacksea_robotics) ideas collection"
    },
    "/ideas/{ideaId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Main platform team (blacksea_robotics) idea comments subcollection"
    },
    "/files/{fileId}": {
      "schema": "SharedFile",
      "description": "Main platform team (blacksea_robotics) shared files collection"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Main platform team (blacksea_robotics) announcements collection"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Main platform team (blacksea_robotics) support tickets collection"
    },
    "/team_reopen_watchers/{watchId}": {
      "schema": "TeamReopenWatch",
      "description": "Reopen notification subscriptions for suspended or under-review teams"
    }
  }
}

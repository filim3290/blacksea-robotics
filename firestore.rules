rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isActiveUser() {
      return isAuthenticated() && (
        request.auth.token.email == "filim3290@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true ||
          !('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status in ['active', 'approved', 'ACTIVE', 'APPROVED']
        ))
      );
    }

    function isManager() {
      return isAuthenticated() && (
        request.auth.token.email == "filim3290@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Yönetici" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Takım Kaptanı" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Yetkili Öğretmen" ||
          ( "roles" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
            ( "Yönetici" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles ||
              "Takım Kaptanı" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles ||
              "Yetkili Öğretmen" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles ) ) ) )
      );
    }

    // --- USERS ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      // First user creation / onboarding (backward-compatible with older client payloads)
      allow create: if isOwner(userId) && (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid);
      // Active managers can update roles, status, team, and revoke access.
      // Normal users can update their profile without changing roles, role, or superAdmin.
      // Rejected, revoked, or pending users can re-apply (transitioning status to 'pending').
      allow update: if isAuthenticated() && (
        (isManager() && isActiveUser()) ||
        (isOwner(userId) &&
         (!('status' in request.resource.data) ||
          request.resource.data.status == resource.data.status ||
          (request.resource.data.status == 'pending' && resource.data.status in ['pending', 'rejected', 'revoked'])) &&
         (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
         (!('roles' in request.resource.data) || request.resource.data.roles == resource.data.roles) &&
         (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == resource.data.isSuperAdmin))
      );
      // Any user can permanently delete their own account; managers can delete non-self, non-founder accounts.
      allow delete: if isOwner(userId) || (
        isManager() &&
        isActiveUser() &&
        userId != request.auth.uid &&
        resource.data.email != "filim3290@gmail.com"
      );
    }

    // --- ROOMS (Open to active team members) ---
    match /rooms/{roomId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if isManager() && isActiveUser();

      // --- MESSAGES IN ROOM ---
      match /messages/{messageId} {
        allow read: if isActiveUser();
        allow create: if isActiveUser() && request.resource.data.senderId == request.auth.uid;
        allow update: if isActiveUser() && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned', 'updatedAt']) &&
            (resource.data.senderId == request.auth.uid || isManager())) ||
          (resource.data.senderId == request.auth.uid &&
            request.resource.data.senderId == resource.data.senderId &&
            request.resource.data.createdAt == resource.data.createdAt &&
            resource.data.createdAt != null &&
            request.time <= resource.data.createdAt + duration.value(1, 'h') &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'editedAt', 'updatedAt']) &&
            request.resource.data.text is string &&
            request.resource.data.text.size() > 0)
        );
        allow delete: if isActiveUser() && (resource.data.senderId == request.auth.uid || isManager());
      }
    }

    // --- IDEAS ---
    match /ideas/{ideaId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && request.resource.data.authorId == request.auth.uid;
      allow update: if isActiveUser();
      allow delete: if isActiveUser() && (resource.data.authorId == request.auth.uid || isManager());

      // --- COMMENTS ON IDEAS ---
      match /comments/{commentId} {
        allow read: if isActiveUser();
        allow create: if isActiveUser() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isActiveUser() && (resource.data.authorId == request.auth.uid || isManager());
      }
    }

    // --- SHARED FILES ---
    match /files/{fileId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && request.resource.data.uploadedById == request.auth.uid;
      allow update: if isActiveUser() && (request.resource.data.uploadedById == request.auth.uid || isManager());
      allow delete: if isActiveUser() && (resource.data.uploadedById == request.auth.uid || isManager());
    }

    // --- ANNOUNCEMENTS ---
    match /announcements/{announcementId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser() && (isManager() || request.resource.data.authorId == request.auth.uid);
      allow delete: if isActiveUser() && (resource.data.authorId == request.auth.uid || isManager());
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notificationId} {
      allow read: if isActiveUser();
      // Active users can create notifications; applicants can notify managers about their own pending membership
      allow create: if isActiveUser() || (
        isAuthenticated() &&
        request.resource.data.type == 'member_pending' &&
        request.resource.data.recipientUserId == 'managers' &&
        request.resource.data.senderId == request.auth.uid
      );
      allow update: if isActiveUser();
      allow delete: if (
        isAuthenticated() &&
        resource.data.recipientUserId == request.auth.uid
      ) || (isActiveUser() && isManager());
    }

    // --- APP CONFIG & UPDATES ---
    match /app_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isManager() && isActiveUser();
    }
  }
}
